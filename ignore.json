{
  "schema": 1,
  "templates": [
    {
      "id": "java",
      "name": "Java",
      "markers": [
        "pom.xml",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle"
      ],
      "rules": [
        ".gradle/",
        "build/",
        "target/",
        "out/",
        "*.class",
        "hs_err_pid*.log",
        ".kotlin/"
      ]
    },
    {
      "id": "node",
      "name": "Node",
      "markers": [
        "package.json"
      ],
      "rules": [
        "node_modules/",
        "npm-debug.log*",
        "yarn-debug.log*",
        "yarn-error.log*",
        "pnpm-debug.log*",
        ".npm/",
        ".yarn/cache/",
        ".yarn/install-state.gz",
        ".eslintcache",
        ".stylelintcache",
        "*.tsbuildinfo",
        ".next/",
        ".nuxt/",
        ".svelte-kit/",
        ".turbo/",
        ".vercel/",
        ".parcel-cache/",
        "dist/",
        "build/",
        "coverage/",
        "storybook-static/"
      ]
    },
    {
      "id": "python",
      "name": "Python",
      "markers": [
        "pyproject.toml",
        "requirements.txt",
        "setup.py",
        "Pipfile"
      ],
      "rules": [
        "__pycache__/",
        "*.py[cod]",
        ".venv/",
        "venv/",
        ".pytest_cache/",
        ".mypy_cache/",
        ".ruff_cache/",
        ".tox/",
        ".nox/",
        ".coverage",
        "htmlcov/",
        "*.egg-info/",
        ".eggs/",
        "build/",
        "dist/",
        ".ipynb_checkpoints/"
      ]
    },
    {
      "id": "rust",
      "name": "Rust",
      "markers": [
        "Cargo.toml"
      ],
      "rules": [
        "target/",
        "**/*.rs.bk"
      ]
    },
    {
      "id": "unity",
      "name": "Unity",
      "markers": [
        "ProjectSettings/"
      ],
      "rules": [
        "/[Ll]ibrary/",
        "/[Tt]emp/",
        "/[Oo]bj/",
        "/[Bb]uild/",
        "/[Bb]uilds/",
        "/[Ll]ogs/",
        "/[Uu]ser[Ss]ettings/",
        "/[Mm]emoryCaptures/",
        "*.csproj",
        "*.unityproj",
        "*.sln",
        "*.suo",
        "*.user",
        "*.pidb",
        "*.pdb",
        "*.mdb",
        "*.opendb",
        "*.VC.db",
        "crashlytics-build.properties"
      ]
    },
    {
      "id": "video",
      "name": "Video",
      "markers": [
        "*.prproj",
        "*.aep",
        "*.drp",
        "*.fcpbundle",
        "*.kdenlive",
        "*.veg"
      ],
      "rules": [
        "Adobe Premiere Pro Auto-Save/",
        "Adobe After Effects Auto-Save/",
        "Media Cache/",
        "Media Cache Files/",
        "Peak Files/",
        "*.pek",
        "*.cfa",
        "*.ims",
        "Render Files/",
        "Transcoded Media/",
        "Proxy Media/",
        "CacheClip/",
        "*.fcpcache/"
      ]
    },
    {
      "id": "xcode",
      "name": "Xcode",
      "markers": [
        "*.xcodeproj/",
        "*.xcworkspace/",
        "Package.swift"
      ],
      "rules": [
        "DerivedData/",
        "build/",
        ".build/",
        "xcuserdata/",
        "*.xcuserstate",
        "*.xcscmblueprint",
        "*.xccheckout",
        "Pods/",
        "Carthage/Build/",
        "*.ipa",
        "*.dSYM",
        "*.dSYM.zip"
      ]
    }
  ]
}
