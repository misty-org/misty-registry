{
  "id": "craft-anything",
  "name": "Craft Anything",
  "description": "Explore how software works and build your own version",
  "maker": "storytold",
  "upstream": "storytold/craft-anything",
  "web_asset": "craft-anything-web-{version}.zip",
  "icon": "assets/app-icon/hicolor/256x256/apps/ai.storyteller.craft-anything.png",
  "manifest": {
    "name": "Craft Anything",
    "logo": "logo.png",
    "entry": "index.html",
    "opens": [],
    "own_origin": true,
    "inline_scripts": true,
    "shim": false,
    "permissions": [
      "files"
    ],
    "mcp": "adapter",
    "adapter": "misty/adapter.js"
  },
  "adapter_shared": "craft",
  "add_copies": [
    {
      "from": "snippets",
      "to": "app/snippets"
    }
  ],
  "strip_top": true
}
