{
  "id": "texturecraft",
  "name": "TextureCraft",
  "description": "Open-source 3D texture painting",
  "maker": "storytold",
  "upstream": "storytold/texturecraft",
  "web_asset": "texturecraft-web-{version}.zip",
  "icon": "assets/app-icon/hicolor/256x256/apps/ai.storyteller.texturecraft.png",
  "manifest": {
    "name": "TextureCraft",
    "logo": "logo.png",
    "entry": "index.html",
    "opens": [
      "image/*"
    ],
    "own_origin": true,
    "inline_scripts": true,
    "shim": false,
    "permissions": [
      "files"
    ],
    "mcp": "adapter",
    "adapter": "misty/adapter.js"
  },
  "adapter_shared": "craft",
  "add_copies": [
    {
      "from": "snippets",
      "to": "app/snippets"
    }
  ],
  "strip_top": true
}
